{
  "name": "antelope-hub",
  "productName": "Antelope Hub",
  "version": "1.3.1",
  "description": "Antelope Hub: multi-chain wallet, bridges, NFTs, drops, creator studio, contract console and asset rescue for WAX, EOS, Telos, XPR Network and Libre",
  "homepage": "https://github.com/SquishEyez/ANThub",
  "license": "MIT",
  "author": {
    "name": "Antelope Hub",
    "email": "antelope-hub@users.noreply.github.com"
  },
  "main": "main.js",
  "private": true,
  "scripts": {
    "prepare-web": "node -e \"const fs=require('fs');fs.rmSync('web',{recursive:true,force:true});fs.cpSync('../android/dist/web','web',{recursive:true})\"",
    "start": "npm run prepare-web && electron .",
    "dist": "npm run prepare-web && electron-builder --linux AppImage deb --x64"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.waxhub",
    "productName": "Antelope Hub",
    "artifactName": "antelope-hub-${version}-${arch}.${ext}",
    "files": [
      "main.js",
      "web/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "linux": {
      "category": "Finance",
      "icon": "build/icon.png",
      "synopsis": "Multi-chain Antelope wallet, bridges and asset rescue",
      "executableName": "antelope-hub",
      "desktop": {
        "StartupWMClass": "Antelope Hub"
      }
    },
    "deb": {
      "packageCategory": "utils",
      "fpm": [
        "--replaces=wax-hub",
        "--conflicts=wax-hub",
        "--provides=wax-hub"
      ]
    },
    "publish": null
  }
}
